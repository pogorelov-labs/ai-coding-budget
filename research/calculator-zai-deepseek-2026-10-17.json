  "calculation_contract": {
    "input_total_includes_cached": true,
    "per_model_partition": "For each model m use inputTotal_m = totalInput * inputTokenShare_m and output_m = totalOutput * outputTokenShare_m. Shares in each family sum to1. Cache-hit is a fraction of model input, not total traffic.",
    "shares_are_token_shares_not_request_shares": true,
    "credit_formula": "sum_m((inputTotal_m*(1-cacheHit_m)*a_m + inputTotal_m*cacheHit_m*c_m + output_m*b_m)/10000 * (0.5+0.5*peakTokenFraction_m)) + mcpCredits",
    "same_mix_shortcut": "If both input and output share s use identical timing/cache, mix coefficients =s*GLM5.3+(1-s)*Flash; consume one shared seat credit budget, never one full quota per model.",
    "api_formula": "sum_m((inputTotal_m*(1-cacheHit_m)*priceUncached_m + inputTotal_m*cacheHit_m*priceCached_m + output_m*priceOutput_m)/1e6); apply DeepSeek temporal rates per date/hour, not Z.ai plan multipliers.",
    "date_simulation": "Calculate both seat rolling5h usage and seat subscription-anchored7day usage; weekly and rolling budgets apply simultaneously. 22days/5 is run-rate approximation only, not monthly bank.",
    "headroom": "user_policy_only; usableFraction0.7 means30%reserve. Do not alter published quotas.",
    "team_overage": "Needs per-seat chronological requests/time buckets. Subscription quota is consumed once; exhausted-window requests can be charged at model API rates times current overage factor. Request-boundary behavior for a request crossing remaining credits is not publicly specified.",
    "renewal_cost": "periodInvoice = seatCount * monthlyList * periodMonths * termDiscount. First-order referral can adjust eligible firstInvoice only after explicit confirmation. Future renewal quotes are scenarios with current rates, not provider guarantees.",
    "sanity_fixture": {
      "input_total_tokens_per_person_day": 20000000,
      "output_tokens_per_person_day": 1000000,
      "glm53_token_share": 0.5,
      "flash_token_share": 0.5,
      "cache_hit": 0.8,
      "peak_token_fraction": 0.4444444444444444,
      "expected_peak_credits": 5248,
      "expected_mixed_credits": 3790.222222222222,
      "expected_5day_credits": 18951.11111111111,
      "quota_headroom_applied": false
    }
  },
