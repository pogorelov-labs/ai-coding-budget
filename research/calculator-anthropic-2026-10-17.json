  "calculatorRules": {
    "tokenNormalization": {
      "inputTotalIncludesCache": true,
      "formulas": {
        "cacheRead": "inputTotal*cacheHitRatio",
        "cacheWriteTotal": "inputTotal*(1-cacheHitRatio)*cacheWriteShareOfMisses",
        "uncachedInput": "inputTotal*(1-cacheHitRatio)*(1-cacheWriteShareOfMisses)",
        "cacheWrite1h": "cacheWriteTotal*oneHourWriteShare",
        "cacheWrite5m": "cacheWriteTotal*(1-oneHourWriteShare)"
      },
      "source": "calculator_assumptions_mapped_to_provider_usage_categories",
      "billableOutputIncludesThinking": true,
      "doNotAddThinkingTwice": true,
      "perModelCost": "(U*pU+W5*pW5+W1*pW1+R*pR+O*pO)/1e6 * batchMultiplier * geoMultiplier * fastMultiplier + applicable tool/runtime fees",
      "longContext": "Haiku 5.5 tier uses total prompt of each request, never daily/monthly volume; split request groups into <=100k and >100k or ask explicit long-context workload share.",
      "ratesMustMatchEachRequestGroup": true
    },
    "modelMix": {
      "simpleSharedProfile": "Specify shares of the same normalized token workload; sum shares=1. Weighted unit USD=sum(modelShare*modelUnitUSD).",
      "categorySpecificProfiles": "For different context/output/cache ratios use per-model category volumes or category-specific shares.",
      "requestShareNotAutomaticallyTokenShare": true,
      "costShareNotAutomaticallyTokenShare": true,
      "budgetEquivalent": "units=eligibleCreditBudgetUSD/weightedUnitUSD; categoryTokens=units*unitCategoryTokens",
      "labelRussian": "Эквивалент бюджета при выбранной модели, смеси и профиле токенов; не квота подписки",
      "noFixedSubscriptionTokensFrom5x20x": true
    },
    "cashAndCredits": {
      "subscriptionCostAlwaysSeparate": true,
      "eligibleApiCash": "max(0, eligibleApiMeteredCostUSD-monthlyApiBonusUSD) after any purchased balance accounting",
      "interactiveCost": "seatFees + cash paid for usage credits; unknown without measured or user-assumed included-use coverage. API bonus cannot offset interactive usage.",
      "bundles": "Track purchases by discrete bundle size, monthly face-value cap, consumption and remaining credit. A $1000 bundle costs $700 upfront even if only $100 is consumed this month.",
      "noApiBonusAcrossTenPersonalAccountsInOneOrg": true
    }
